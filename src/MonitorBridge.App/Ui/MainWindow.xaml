<Window x:Class="MonitorBridge.App.Ui.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MonitorBridge.App.Ui"
        xmlns:svc="clr-namespace:MonitorBridge.App.Services"
        Title="{svc:L app.title}" Width="1040" Height="700" MinWidth="820" MinHeight="560"
        Background="#F1F5F9" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상태 배너 -->
        <Border x:Name="Banner" Grid.Row="0" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Background="#E2E8F0">
            <StackPanel>
                <TextBlock x:Name="BannerTitle" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="BannerDetail" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#334155"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True" Background="White">
                <ui:DeskCanvas x:Name="Desk" MinHeight="300"/>
            </Border>

            <Border Grid.Column="2" CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Panel" Binding.SourceUpdated="OnFieldUpdated">
                        <TextBlock Text="{svc:L sel.title}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="SelTitle" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelDetail" Foreground="#475569" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelSource" Foreground="#64748B" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="{svc:L size.title}" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Lbl}" Text="{svc:L size.diag}" Grid.Row="0"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DiagonalInch, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="{svc:L size.inch}" Grid.Row="0" Grid.Column="2" Margin="6,0,0,0"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="{svc:L size.w}" Grid.Row="1"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WidthMm, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="mm" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="{svc:L size.h}" Grid.Row="2"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HeightMm, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="mm" Grid.Row="2" Grid.Column="2" Margin="6,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{svc:L pos.title}" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Lbl}" Text="{svc:L pos.x}"/>
                            <TextBox Grid.Column="1" Text="{Binding XMm, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="mm" Grid.Column="2" Margin="6,0,0,0"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="{svc:L pos.y}" Grid.Row="1"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding YMm, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="mm" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="{svc:L pos.hint}"/>

                        <TextBlock Text="{svc:L align.title}" FontWeight="SemiBold" Margin="0,6,0,4"/>
                        <UniformGrid Rows="1">
                            <Button Style="{StaticResource Btn}" Content="{svc:L align.start}" Click="OnAlignStart" Margin="0,0,4,0" Padding="4,6"/>
                            <Button Style="{StaticResource Btn}" Content="{svc:L align.center}" Click="OnAlignCenter" Margin="0,0,4,0" Padding="4,6"/>
                            <Button Style="{StaticResource Btn}" Content="{svc:L align.end}" Click="OnAlignEnd" Margin="0" Padding="4,6"/>
                        </UniformGrid>

                        <TextBlock Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Text="{svc:L help.drag}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn}" Content="{svc:L btn.identify}" Click="OnIdentify"/>
                <Button Style="{StaticResource Btn}" Content="{svc:L btn.redetect}" Click="OnRedetect"/>
                <Button Style="{StaticResource Btn}" Content="{svc:L btn.reset}" Click="OnReset"/>
                <CheckBox x:Name="StartupCheck" Content="{svc:L chk.startup}" VerticalAlignment="Center" Margin="8,0,0,0" Click="OnStartupClick"/>
                <TextBlock Style="{StaticResource Lbl}" Text="{svc:L lang.label}" Margin="16,0,6,0"/>
                <ComboBox x:Name="LangBox" Width="100" VerticalAlignment="Center" SelectionChanged="OnLangChanged">
                    <ComboBoxItem Tag="en" Content="English"/>
                    <ComboBoxItem Tag="ko" Content="한국어"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ToggleBtn" Style="{StaticResource Btn}" Click="OnToggle" MinWidth="96"/>
                <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryBtn}" Content="{svc:L btn.apply}" Click="OnApply" MinWidth="96" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
