<Window x:Class="MonitorBridge.App.Ui.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MonitorBridge.App.Ui"
        Title="MonitorBridge — 멀티 모니터 커서 보정" Width="1040" Height="700" MinWidth="820" MinHeight="560"
        Background="#F1F5F9" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상태 배너 -->
        <Border x:Name="Banner" Grid.Row="0" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Background="#E2E8F0">
            <StackPanel>
                <TextBlock x:Name="BannerTitle" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="BannerDetail" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#334155"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True" Background="White">
                <ui:DeskCanvas x:Name="Desk" MinHeight="300"/>
            </Border>

            <Border Grid.Column="2" CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Panel" Binding.SourceUpdated="OnFieldUpdated">
                        <TextBlock Text="선택한 모니터" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="SelTitle" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelDetail" Foreground="#475569" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelSource" Foreground="#64748B" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="실제 화면 크기" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Lbl}" Text="대각선" Grid.Row="0"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DiagonalInch, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="인치" Grid.Row="0" Grid.Column="2" Margin="6,0,0,0"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="가로 길이" Grid.Row="1"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WidthMm, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="mm" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="세로 길이" Grid.Row="2"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HeightMm, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="mm" Grid.Row="2" Grid.Column="2" Margin="6,0,0,0"/>
                        </Grid>

                        <TextBlock Text="책상 위 위치 (왼쪽 위 모서리)" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Lbl}" Text="가로 위치 X"/>
                            <TextBox Grid.Column="1" Text="{Binding XMm, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="mm" Grid.Column="2" Margin="6,0,0,0"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="높이 위치 Y" Grid.Row="1"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding YMm, StringFormat=F1, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" KeyDown="OnFieldKeyDown"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="mm" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="Y는 아래쪽이 +입니다. 두 모니터의 Y를 같게 하면 윗선이, Y+세로를 같게 하면 아랫선이 같은 높이가 됩니다."/>

                        <TextBlock Text="이웃 모니터에 맞춤" FontWeight="SemiBold" Margin="0,6,0,4"/>
                        <UniformGrid Rows="1">
                            <Button Style="{StaticResource Btn}" Content="윗/왼쪽선" Click="OnAlignStart" Margin="0,0,4,0" Padding="4,6"/>
                            <Button Style="{StaticResource Btn}" Content="가운데" Click="OnAlignCenter" Margin="0,0,4,0" Padding="4,6"/>
                            <Button Style="{StaticResource Btn}" Content="아랫/오른쪽선" Click="OnAlignEnd" Margin="0" Padding="4,6"/>
                        </UniformGrid>

                        <TextBlock Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Text="드래그로 옮기면 다른 모니터 가장자리에 붙습니다(Alt를 누르면 해제). Windows 배율은 실제 크기로 쓰지 않으며, 모니터 정보를 못 읽은 경우 24인치 추정값이니 꼭 직접 입력해 주세요."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn}" Content="화면 식별" Click="OnIdentify"/>
                <Button Style="{StaticResource Btn}" Content="다시 감지" Click="OnRedetect"/>
                <Button Style="{StaticResource Btn}" Content="기본값으로 되돌리기" Click="OnReset"/>
                <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 트레이로 실행" VerticalAlignment="Center" Margin="8,0,0,0" Click="OnStartupClick"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ToggleBtn" Style="{StaticResource Btn}" Click="OnToggle" MinWidth="96"/>
                <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryBtn}" Content="적용" Click="OnApply" MinWidth="96" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
